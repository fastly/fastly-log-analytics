+bool DuckLakeTransaction::InlinedTableFlushed(const string &table_name) const {
+	for (const auto &flushed_table : GetFlushedInlinedTables()) {
+		if (flushed_table.inlined_table.table_name == table_name) {
+			return true;
+		}
+	}
+	return false;
