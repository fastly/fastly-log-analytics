# ── Local development environment variables ───────────────────────────────────
# Copy this file to .env and uncomment/edit values you want to override.
# None of these are required to start the app — defaults are shown below.

# ── Ports ──────────────────────────────────────────────────────────────────────
# Backend port (default: 8000)
# BACKEND_PORT=8000

# Frontend port (default: 3000)
# FRONTEND_PORT=3000

# ── DuckDB ─────────────────────────────────────────────────────────────────────
# DuckDB memory limit (default: 4GB)
# DUCKDB_MEMORY_LIMIT=4GB

# DuckDB thread count (default: auto-detect from CPU count)
# DUCKDB_THREADS=4

# ── Ingest pipeline ────────────────────────────────────────────────────────────
# Number of raw .gz files processed per ingest batch (default: 500)
# INGEST_CHUNK_SIZE=500

# Number of buffered files committed to Iceberg per commit chunk (default: 50).
# Lower this if commits run out of memory on small hosts.
# BUFFER_COMMIT_CHUNK_SIZE=50

# ── CDN-fronted FOS proxy (telemetry / read path) ──────────────────────────────
# Per-request upstream timeout for proxied FOS reads, in seconds (default: 90).
# Raise this if you regularly fetch very large objects through the proxy.
# FOS_PROXY_UPSTREAM_TIMEOUT_S=90

# Keep-alive idle timeout for the proxy's upstream connection pool, in seconds
# (default: 4).
# FOS_PROXY_KEEPALIVE_S=4

# In-memory cap for the Iceberg manifest cache, in MB (default: 256).
# FOS_MANIFEST_CACHE_MB=256

# ── Optional Fastly API integration ────────────────────────────────────────────
# Fastly API token used by the Usage & Cost page to pull live traffic stats and
# billing data. Requires the "Billing" permission. Without this, cost
# estimation falls back to manual inputs.
# FASTLY_API_KEY=

# ── Frontend ───────────────────────────────────────────────────────────────────
# Override the URL the frontend uses to call the backend. Only needed if the
# backend runs on a different host than the frontend.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ── Observability ──────────────────────────────────────────────────────────────
# OpenTelemetry exporter. Default 'none' — no spans/metrics leave the process.
# Set 'console' to dump spans and 60s metric snapshots to stdout (loud; useful
# locally when chasing a perf regression). Don't set 'console' in prod — it
# pollutes log aggregation with ~1 MB/min of JSON.
# OTEL_EXPORTER=console

# ── Docker only ────────────────────────────────────────────────────────────────
# Set automatically by docker-compose; not needed for local dev.
# API_PROXY_URL=http://backend:8000
