          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{status_code=\"STATUS_CODE_ERROR\"}[5m]))",
          "legendFormat": "{{span_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "description": "The rate of API requests returning HTTP error statuses (5xx/4xx), broken down by endpoint. A non-zero rate here usually requires investigation."
    },
    {
      "type": "row",
