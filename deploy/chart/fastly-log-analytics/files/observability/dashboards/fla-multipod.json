  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "expr": "changes(process_start_time_seconds[5m]) > 0",
        "iconColor": "red",
        "name": "Process Restarts",
        "step": "15s",
        "tagKeys": "job, instance",
        "textFormat": "Restarted: {{job}} - {{instance}}",
        "titleFormat": "Process Restart",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": false,
        "expr": "vector(1)",
        "iconColor": "green",
