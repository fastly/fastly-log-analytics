    {
      "id": 13,
      "type": "timeseries",
      "title": "Query Execution Duration (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 32,
        "w": 8,
        "h": 9
      },
