    {
      "id": 14,
      "type": "timeseries",
      "title": "Connection Pool Thread Wait (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 32,
        "w": 8,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
