{
	admin off
	auto_https off
	log {
		format filter {
			wrap json
			fields {
				request>headers>X-Admin-Gateway-Token delete
				request>headers>X-Admin-Token delete
			}
		}
	}
}

(redacted_log) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>X-Admin-Gateway-Token delete
				request>headers>X-Admin-Token delete
			}
		}
		level INFO
	}
}

:80 {
    request_header -X-Admin-Gateway-Token
    request_header -X-Admin-Token
    @api path /api/* /js/* /rum-beacon
    # Caddy forwards the REAL client IP (it appends the peer address to
    # X-Forwarded-For by default). Never stamp a synthetic XFF here: a
    # hardcoded `header_up X-Forwarded-For 127.0.0.1` classifies every
    # request that reaches this listener as loopback-admin in the backend's
    # RemoteAccessMiddleware — a full auth bypass for anyone who can reach
    # port 80. The backend only trusts XFF from the pinned compose subnet
    # (TRUSTED_PROXY_IPS / UVICORN_FORWARDED_ALLOW_IPS in
    # docker-compose.multipod.yml), so this proxy is the only party that can
    # assert a client IP.
    reverse_proxy @api backend:8000 {
        flush_interval -1
        transport http {
            # 120s -> 180s 2026-10-01: /api/network-health's rollup-ineligible
            # raw-scan fallback (any freshly-provisioned/low-history service)
            # took ~117.5s under concurrent synthetic load, right at the old
            # ceiling. See root Caddyfile's admin-tunnel block for the same
            # pattern on dashboard-30d.
            response_header_timeout 180s
            read_timeout 180s
        }
    }

    # Everything else → Next.js frontend.
    reverse_proxy frontend:3000

    import redacted_log
}
