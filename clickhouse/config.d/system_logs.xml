<clickhouse>
    <!-- Disable memory profiler trace log to prevent hundreds of millions of allocation traces -->
    <trace_log remove="1"/>
    <!-- Disable query pipeline profiler -->
    <processors_profile_log remove="1"/>

    <!-- Retain system logs for only 1 day to prevent unbounded disk and memory growth -->
    <metric_log>
        <ttl>event_date + INTERVAL 1 DAY DELETE</ttl>
    </metric_log>
    <asynchronous_metric_log>
        <ttl>event_date + INTERVAL 1 DAY DELETE</ttl>
    </asynchronous_metric_log>
    <text_log>
        <ttl>event_date + INTERVAL 1 DAY DELETE</ttl>
    </text_log>
    <query_log>
        <ttl>event_date + INTERVAL 1 DAY DELETE</ttl>
    </query_log>
    <part_log>
        <ttl>event_date + INTERVAL 1 DAY DELETE</ttl>
    </part_log>
</clickhouse>
